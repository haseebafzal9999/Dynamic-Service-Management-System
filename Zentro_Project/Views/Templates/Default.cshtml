
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Default</title>
    <link rel="stylesheet" href="~/css/normalize.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/zentro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom_styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/commonpreview.css" />

    <!-- Select2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />




    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <link href="https://fonts.googleapis.com" rel="preconnect">
    <link href="https://fonts.gstatic.com" rel="preconnect" crossorigin="anonymous">
    <script src="https://ajax.googleapis.com/ajax/libs/webfont/1.6.26/webfont.js" type="text/javascript"></script>
    <script type="text/javascript">WebFont.load({  google: {    families: ["Inter:100,200,300,regular,500,600,700,800,900","Roboto:100,300,regular,500,700,900"]  }});</script>
    <script type="text/javascript">!function(o,c){var n=c.documentElement,t=" w-mod-";n.className+=t+"js",("ontouchstart"in o||o.DocumentTouch&&c instanceof DocumentTouch)&&(n.className+=t+"touch")}(window,document);</script>
    <link href="/images/fox_icon_fav.png" rel="shortcut icon" type="image/x-icon">
    <link href="/images/fox_icon_webclip.png" rel="apple-touch-icon">

    <link href="~/css/loginsignupmodal.css" rel="stylesheet" />

</head>
<body>
    <div class="container main">
        <div class="main-view scroll" style="height:100vh !important;">
            <div class="main-window-container">
                <div class="view-window">
                    <div class="container-c page-root body-c">
                        <header class="create-window-header-c title-margin-c">
                            <div class="page-title-container-c" style="padding-left:12px;">
                                <h1 class="main-heading-c"></h1>
                            </div>

                            @if (TempData["Error"] != null)
                            {
                                <div class="alert alert-danger">@TempData["Error"]</div>
                            }

                        </header>

                        <form id="userAnswersForm">

                            <div class="capsule-containers-c">
                                <div id="question-render-root"></div>

                                <!-- METAFIELD  -->
                                <div class="item-c" id="metafields-container" style="display: none;">
                                    <div class="section-container-c">
                                        <header class="dropdown-header-c parentToggler shadow-c metafield-header">
                                            <span class="dropdown-header-text-c">Additional Information</span>
                                            <span class="carrot-c">
                                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                                                    <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
                                                </svg>
                                            </span>
                                            <div class="section-line-breaker-c hidden"></div>
                                        </header>
                                    </div>

                                    <div class="section-container-c shadow-c hidden metafield-section">
                                        <section class="section-box-c top-corners-c less-padding-c">
                                            <div id="metafields-render-root">
                                            </div>
                                        </section>
                                    </div>
                                </div>
                            </div>

                            <div class="submit-container-c">
                                <div class="save-btn-container-c submit-width-c">
                                    <button id="btn-save-1" type="button" class="btn-save-c submit-padding-c">
                                        SUBMIT
                                    </button>
                                </div>
                            </div>
                        </form>

                    </div>

                </div>
            </div>
        </div>
    </div>

        <div id="authModal" class="modal-overlay-auth-c">
        <!-- Your existing code starts -->
        <div class="new-section-container-c">
            <div class="new-sub-box-c" style="background: white;">

                <!-- Strap/Header -->
                <div class="box-strap-c">
                    <span class="modal-title-c"></span>
                    @* <button class="close-btn-c" id="closeModal">&times;</button> *@
                </div>

                <div class="inner-body-c">
                    <!-- Logo -->
                    <div class="logo-section-c"></div>

                    <!-- LOGIN FORM -->
                    <form action="/api/Account/SignInAsync" method="post" id="login-form">
                        <input type="hidden" id="tokenInput" name="token" value="@ViewData["Token"]" />
                        <h1 class="login-head-c">Welcome back! Enter your email and password to continue.</h1>
                        <div class="secondary-action-c">
                            First time here?
                            <a href="#" id="show-signup" class="login-link-c" style="text-decoration: underline;">Create an account</a>
                        </div>
                        <div class="form-section-c">
                            <div class="input-group-c">
                                <h3>Email address</h3>
                                <input type="text" name="Email" placeholder="" style="margin-bottom:15px;">
                            </div>

                            <div class="input-group-c">
                                <label for="password" class="login-label-c w-clearfix-c">
                                    Password
                                    <a href="#" id="show-forgot" class="password-link-c" style="text-decoration: underline;">Forgot your password?</a>
                                </label>
                                <input type="password" name="Password" placeholder="" >
                            </div>

                            <button class="submit-btn-c">Login Now</button>
                        </div>
                    </form>

                    <!-- SIGNUP FORM -->
                    <form action="/api/Account/OnPostAsync" method="post">
                        <div id="signup-form" class="form-wrapper-c hidden">
                            <input type="hidden" id="tokenInput" name="token" value="@ViewData["Token"]" />
                            <h1 class="login-head-c">Start managing your account by entering your information below</h1>
                            <div class="secondary-action-c">
                                Already have an account?
                                <a href="#" id="show-login" class="login-link-c" style="text-decoration: underline;">Login here</a>
                            </div>
                            <div class="form-section-c" style="gap: 0 !important;">
                                <div class="input-group-c">
                                    <div class="parent-cont-c">
                                        <div>
                                            <h3>First Name</h3>
                                            <input type="text" name="FirstName" placeholder="">
                                        </div>
                                        <div>
                                            <h3>Last Name</h3>
                                            <input type="text" name="LastName" placeholder="">
                                        </div>
                                    </div>
                                </div>

                                <div class="input-group-c">
                                    <h3>Phone Number</h3>
                                    <input type="text" name="PhoneNumber" placeholder="">
                                </div>

                                <div class="input-group-c">
                                    <h3>Email address</h3>
                                    <input type="text" name="Email" placeholder="">
                                </div>

                                <div class="input-group-c">
                                    <h3>Password</h3>
                                    <input type="password" name="Password" placeholder="">
                                </div>

                                <button class="submit-btn-c">Sign Up</button>
                            </div>
                        </div>
                    </form>
                    <!-- FORGOT PASSWORD FORM -->
                    <div id="forgot-form" class="form-wrapper-c hidden">
                        <h1 class="login-head-c">Forgotten you password? Reset it by entering your information below</h1>
                        <div class="secondary-action-c">
                            Remembered your password?
                            <a href="#" id="back-to-login" class="login-link-c" style="text-decoration: underline;">Login here</a>
                        </div>
                        <div class="form-section-c">
                            <div class="input-group-c">
                                <h3>Email address</h3>
                                <input type="text" placeholder="">
                            </div>
                            <button class="submit-btn-c">Send Link</button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>


    <script src="~/js/general/zentro.js" asp-append-version="true"></script>
    <script src="~/js/general/menu.js" asp-append-version="true"></script>
    <script src="~/js/general/global.js" asp-append-version="true"></script>
    <script src="~/js/general/general.js" asp-append-version="true"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        window.isUserAuthenticated = @User.Identity.IsAuthenticated.ToString().ToLower();
    </script>
    <script src="~/js/defaulttemplate/auth.js"></script>
    <script src="~/js/Quotes/Default.js"></script>
</body>
</html>
