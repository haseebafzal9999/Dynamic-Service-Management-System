@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<html lang="en" class="w-mod-ix" data-wf-page="66fbfcb699ed1da7c72ec002" data-wf-site="66f2a216066343224a26deed">
<head>
    <meta charset="utf-8">
    <title>Zentro</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="~/css/normalize.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/components.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/zentro.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <script type="text/javascript">!function (o, c) { var n = c.documentElement, t = " w-mod-"; n.className += t + "js", ("ontouchstart" in o || o.DocumentTouch && c instanceof DocumentTouch) && (n.className += t + "touch") }(window, document);</script>
    <link href="/images/fox_icon_fav.png" rel="shortcut icon" type="image/x-icon">
    <link href="/images/fox_icon_webclip.png" rel="apple-touch-icon">
</head>
<body>
    <div class="page-wrap bg-radial">
        <div class="brand-container">
            <div class="brand" aria-hidden="false">
                <img src="/images/zentro_logo_orange.png">
            </div>

            <div class="card" role="main" aria-labelledby="login-title">
                <div class="card-inner">
                    @Html.AntiForgeryToken()

                    <!-- LOGIN PANEL -->
                    <div id="login-panel" class="" data-wf-element-id="9bf8dfa6-9a2d-a328-6041-d2fbb0ddffb6">
                        <input type="text" name="username" autocomplete="username" style="display:none">
                        <input type="password" name="password" autocomplete="current-password" style="display:none">


                        <div class="heading heading-center" id="login-title">Log into your account</div>

                        <div class="field">
                            <label for="email" class="hidden">Email / Username</label>
                            <input type="text" id="email" name="custom-text" placeholder="Username or email" autocomplete="no" class="input-small">
                            <div><span id="email-error" class="text-danger"></span></div>
                        </div>

                        <div class="field">
                            <label for="password" class="hidden">Password</label>
                            <input type="password" id="password" name="Password" placeholder="Password" autocomplete="no" class="input-small">
                            <div><span id="password-error" class="text-danger"></span></div>
                        </div>

                        <div id="general-error" role="alert"></div>

                        <div class="field">
                            <button id="login" type="button" class="btn-login btn-disable">LOGIN</button>
                        </div>

                        <div class="meta-row meta-center">
                            <div class="forgotten-link-wrapper">
                                <a data-w-id="07965d5e-be0e-a998-260e-46402914780b" href="#" class="forgotten-password-link w-inline-block">
                                    <div class="text-link">CAN'T LOG IN?</div>
                                    <div class="line"></div>
                                </a>
                            </div>
                       
                        </div>

                        <div class="divider divider-tight" aria-hidden="true"></div>
                    </div>

                    <!-- FORGOT PANEL -->
                    <div id="forgot-panel" class="hidden">
                        <div class="heading heading-center mb-15">Forgot Password</div>
                        <div class="forgot-sub forgot-center">Enter your account’s email and we’ll send you an email to reset the password.</div>

                        <div class="field">
                            <label for="password-reset" class="hidden">Email</label>
                            <input type="email" id="password-reset" name="email" placeholder="name@example.com" autocomplete="no" class="input-small">
                            <div><span id="password-reset-error" class="text-danger"></span></div>
                        </div>

                        <div class="field">
                            <button class="send-reset btn-disable" type="button">Send email</button>
                        </div>

                        <div class="meta-row meta-center mt-20">
                            <div class="forgotten-link-wrapper">
                                <a data-w-id="01207391-1c46-c1b1-d967-f28074eccb42" href="#" class="login-link w-inline-block">
                                    <div class="text-link">GOT AN ACCOUNT? LOG IN</div>
                                    <div style="transform: translate3d(0px, 0px, 0px) scale3d(0, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg); transform-style: preserve-3d;" class="line"></div>
                                </a>
                            </div>
                        </div>
                    </div>

                    <div class="footer-text">© 2025 Zentro. All rights reserved.</div>
                </div>
            </div>
        </div>
    </div>

    <script src="/lib/jquery/dist/jquery.min.js" asp-append-version="true"></script>
    <script src="/js/general/zentro.js" asp-append-version="true"></script>
    <script src="/js/general/userAuth.js" asp-append-version="true"></script>
</body>
</html>

